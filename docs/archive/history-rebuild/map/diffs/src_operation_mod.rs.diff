+/// Builds the item shown for one side of a replace prompt, on compio's blocking pool because
+/// `item_from_path` stats the path and would otherwise stall the executor on a slow mount.
+async fn build_replace_item(path: PathBuf) -> Option<Box<crate::item::Item>> {
+    match compio::runtime::spawn_blocking(move || {
+        crate::item::item_from_path(path, IconSizes::default())
+    })
+    .await
+    {
+        Ok(Ok(item)) => Some(Box::new(item)),
+        Ok(Err(err)) => {
+            log::warn!("{err}");
+            None
+        }
+        Err(err) => {
+            log::error!("compio task failed while building replace item: {err}");
+            None
+        }
+    }
+}
+
+fn already_exists_error(to: &Path) -> io::Error {
+    let message = if to.is_dir() {
+        fl!("folder-already-exists")
+    } else {
+        fl!("file-already-exists")
+    };
+    io::Error::new(io::ErrorKind::AlreadyExists, message)
+}
+
+async fn rename_noreplace(from: PathBuf, to: PathBuf) -> io::Result<()> {
+    if from == to {
+        // Confirming the dialog with the name unchanged renames a path onto itself.
+        return Ok(());
+    }
+
+    #[cfg(target_os = "linux")]
+    {
+        use std::ffi::CString;
+        use std::os::unix::ffi::OsStrExt;
+
+        let from_c = CString::new(from.as_os_str().as_bytes())?;
+        let to_c = CString::new(to.as_os_str().as_bytes())?;
+        compio::runtime::spawn_blocking(move || {
+            let rc = unsafe {
+                libc::renameat2(
+                    libc::AT_FDCWD,
+                    from_c.as_ptr(),
+                    libc::AT_FDCWD,
+                    to_c.as_ptr(),
+                    libc::RENAME_NOREPLACE,
+                )
+            };
+            if rc == 0 {
+                return Ok(());
+            }
+            let err = io::Error::last_os_error();
+            // Telling a file from a folder stats the target, so it stays off the async runtime.
+            Err(match err.raw_os_error() {
+                Some(libc::EEXIST | libc::ENOTEMPTY) => already_exists_error(&to),
+                _ => err,
+            })
+        })
+        .await
+        .map_err(|err| io::Error::other(format!("compio task failed while renaming: {err}")))?
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "renaming without replacing an existing file is not supported on this platform",
+        ))
+    }
+}
