+            paths: vec![source],
+            to: target.clone(),
+            archive_type,
+            password: None,
+        };
+        let run = async move {
+            operation
+                .perform(&sync::Mutex::new(tx).into(), Controller::default())
+                .await
+        };
+        let drain = async move { while rx.next().await.is_some() {} };
+        let result = future::join(run, drain).await.0;
+        Ok((dir, target, result))
